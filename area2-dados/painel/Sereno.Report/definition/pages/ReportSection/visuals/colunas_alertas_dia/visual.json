{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "colunas_alertas_dia",
  "position": {
    "x": 240,
    "y": 420,
    "z": 9000,
    "height": 290,
    "width": 1030
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "calendario"
                    }
                  },
                  "Property": "data"
                }
              },
              "queryRef": "calendario.data",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "alertas"
                    }
                  },
                  "Property": "resposta"
                }
              },
              "queryRef": "alertas.resposta"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "alertas"
                    }
                  },
                  "Property": "Alertas enviados"
                }
              },
              "queryRef": "alertas.Alertas enviados"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Alertas enviados por dia, pela resposta do produtor'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}