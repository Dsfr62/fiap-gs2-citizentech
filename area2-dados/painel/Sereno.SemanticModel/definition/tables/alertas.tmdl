		sourceColumn: explicacao

		annotation SummarizationSetBy = Automatic

	partition alertas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "alertas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"alerta_id", Int64.Type}, {"canteiro_chave", type text}, {"data", type date}, {"hora", type text}, {"regar", type logical}, {"minutos", Int64.Type}, {"litros", type number}, {"chuva_prevista_mm", type number}, {"umidade_solo_usada", type number}, {"decidido_por", type text}, {"resposta", type text}, {"explicacao", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

