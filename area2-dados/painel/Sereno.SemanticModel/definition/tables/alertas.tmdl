	column decidido_por
		dataType: string
		lineageTag: e92c36d8-9f06-41c9-990a-dc7ee283e6ce
		summarizeBy: none
		sourceColumn: decidido_por

		annotation SummarizationSetBy = Automatic

	column resposta
		dataType: string
		lineageTag: ffe1febb-32a9-4381-bc76-0df6b41d0a11
		summarizeBy: none
