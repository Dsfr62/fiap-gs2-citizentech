table fato_diario_canteiro
	lineageTag: 9b7ef2fc-eb33-46f6-bf22-ac3374a78d32

	measure 'Água economizada (L)' = SUM ( fato_diario_canteiro[litros_economizados] )
		formatString: #,0
		lineageTag: 67caaa5b-f467-4d43-91a3-c22bf9d7c0e6

	measure 'Água economizada (%)' = DIVIDE ( [Água economizada (L)], SUM ( fato_diario_canteiro[litros_calendario] ) )
		formatString: 0.0%
		lineageTag: 331146dc-07de-4965-afe1-6839664f172e

	measure 'Horas abaixo do mínimo' = SUM ( fato_diario_canteiro[horas_abaixo_do_minimo] )
		formatString: #,0
		lineageTag: 401cfe55-519b-4c9a-bce8-2568b2b2eeff

	measure 'Dias com risco alto de doença' = CALCULATE ( DISTINCTCOUNT ( fato_diario_canteiro[data] ), fato_diario_canteiro[risco_doenca] = "alto" )
		formatString: #,0
		lineageTag: 952369f8-43fc-4b50-85eb-c4fa3a0acd62

