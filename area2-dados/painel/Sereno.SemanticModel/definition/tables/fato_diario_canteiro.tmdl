	partition fato_diario_canteiro = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fato_diario_canteiro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"canteiro_chave", type text}, {"data", type date}, {"umidade_media", type number}, {"umidade_minima_do_dia", type number}, {"horas_com_leitura", Int64.Type}, {"horas_abaixo_do_minimo", Int64.Type}, {"temp_max_sensor", type number}, {"temp_min_sensor", type number}, {"alertas_enviados", Int64.Type}, {"alertas_para_regar", Int64.Type}, {"respostas_fiz", Int64.Type}, {"respostas_nao_fiz", Int64.Type}, {"respostas_aguardando", Int64.Type}, {"regas", Int64.Type}, {"minutos_regados", Int64.Type}, {"litros_usados", type number}, {"chuva_mm", type number}, {"et0_mm", type number}, {"umidade_ar_media", type number}, {"temp_min_ar", type number}, {"temp_max_ar", type number}, {"horas_favoraveis_doenca", Int64.Type}, {"risco_doenca", type text}, {"risco_geada", type text}, {"risco_calor", type text}, {"litros_calendario", type number}, {"litros_economizados", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

